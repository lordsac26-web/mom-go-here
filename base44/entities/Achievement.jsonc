{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "achievement_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "earned_date": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "achievement_key",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}