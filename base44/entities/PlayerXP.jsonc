{
  "name": "PlayerXP",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "total_xp": {
      "type": "number",
      "description": "Lifetime XP earned"
    },
    "level": {
      "type": "number",
      "description": "Current player level"
    },
    "games_completed": {
      "type": "number",
      "description": "Total games completed"
    },
    "last_xp_gain": {
      "type": "number",
      "description": "XP awarded from the last game"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}