{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "memory_text": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "entry_date": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "entry_date"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}