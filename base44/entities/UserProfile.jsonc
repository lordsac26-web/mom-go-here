{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "birthday": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "city": {
      "type": "string"
    },
    "favorite_games": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "religion": {
      "type": "string",
      "enum": [
        "Christianity",
        "Catholicism",
        "Judaism",
        "Islam",
        "Hinduism",
        "Buddhism",
        "Sikhism",
        "None"
      ]
    },
    "last_quote_date": {
      "type": "string"
    },
    "last_verse_date": {
      "type": "string"
    },
    "last_quote_index": {
      "type": "number"
    },
    "last_verse_index": {
      "type": "number"
    },
    "card_back_design": {
      "type": "string",
      "description": "Solitaire card back design key"
    },
    "chatbot_name": {
      "type": "string",
      "description": "Custom name for the AI assistant (default: Rosie)"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}