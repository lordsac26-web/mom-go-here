{
  "name": "CheckerCosmetic",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "unlocked_boards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of unlocked board style keys"
    },
    "unlocked_pieces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of unlocked piece skin keys"
    },
    "active_board": {
      "type": "string",
      "description": "Currently equipped board style key"
    },
    "active_pieces": {
      "type": "string",
      "description": "Currently equipped piece skin key"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}