{
  "name": "Contact",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "birthday": {
      "type": "string",
      "description": "YYYY-MM-DD format"
    },
    "anniversary": {
      "type": "string",
      "description": "YYYY-MM-DD format"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "Family",
        "Friend",
        "Neighbor",
        "Coworker",
        "Other"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "name",
    "birthday"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}