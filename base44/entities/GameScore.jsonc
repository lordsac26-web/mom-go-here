{
  "name": "GameScore",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "Player display name at time of score submission"
    },
    "game_name": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "duration_seconds": {
      "type": "number"
    },
    "difficulty": {
      "type": "string"
    },
    "completed": {
      "type": "boolean"
    }
  },
  "required": [
    "user_email",
    "game_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}