{
  "name": "ZenPoints",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "description": "YYYY-MM-DD date of the challenge"
    },
    "game_path": {
      "type": "string",
      "description": "Path of the assigned game"
    },
    "game_name": {
      "type": "string"
    },
    "game_emoji": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "description": "Whether user played the challenge game"
    },
    "points_earned": {
      "type": "number",
      "description": "Zen points earned (10 per completion)"
    }
  },
  "required": [
    "user_email",
    "date",
    "game_path"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}